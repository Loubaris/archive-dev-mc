{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.boom_stick": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'boom_stick' && query.is_using_item" } ],
          "on_entry": [
            "@s sp:n_tnt_shoot"
          ]
        },
        "click1": {
          "transitions": [ { "default": "query.get_equipped_item_name == 'boom_stick' && query.is_using_item" } ],
          "on_entry": [
            "@s sp:n_tnt_shoot"
          ]
        }
      }
    }, 
