    "controller.animation.poison_attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'duskblade_sword' && variable.attack_time" } ],
	  "on_entry": [
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ effect @s poison 10 3 true",
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ summon sw:spark_poison ~ ~ ~"
	  ]
        },
        "click1": {
          "transitions": [ { "default": "query.get_equipped_item_name == 'duskblade_sword' && !variable.attack_time" } ],
          "on_entry": [
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ effect @s poison 10 3 true",
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ summon sw:spark_poison ~ ~ ~"
          ]
        }
      }
    },
    "controller.animation.fire_attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.is_item_name_any('slot.armor.head', 0, 'sw:fire_armor')" } ],
	  "on_entry": [
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ setblock ~ ~ ~ fire 0",
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ particle sw:fire_impact ~ ~ ~"
	  ]
        },
        "click1": {
          "transitions": [ { "default": "query.is_item_name_any('slot.armor.head', 0, 'sw:fire_armor')" } ],
          "on_entry": [
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ fill ~-1 ~ ~-1 ~1 ~ ~1 air 0 replace fire",
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ particle sw:fire_impact ~ ~ ~"
          ]
        }
      }
    },
    "controller.animation.electricity_attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'lightning_sword' && variable.attack_time" } ],
	  "on_entry": [
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ particle sw:electricity ~ ~1 ~"
	  ]
        },
        "click1": {
          "transitions": [ { "default": "query.get_equipped_item_name == 'lightning_sword' && !variable.attack_time" } ],
          "on_entry": [
            "/execute @e[type=!player,type=!item,r=5] ~ ~ ~ particle sw:electricity ~ ~1 ~"
          ]
        }
      }
    },
    "controller.animation.attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "variable.attack_time" } ],
	  "on_entry": [
            "/tag @s add attack"
	  ]
        },
        "click1": {
          "transitions": [ { "default": "!variable.attack_time" } ],
          "on_entry": [
            "/tag @s remove attack"
          ]
        }
      }
    },
    "controller.animation.walk": {
      "states": {
        "default": {
          "transitions": [ { "walking": "(1.0)" } ],
          "on_entry": [
            "/function commands"
          ]
        },
        "walking": {
          "transitions": [ { "default": "(1.0)" } ],
          "on_entry": [
            "/function commands"
          ]
        }
      }
    }
  }
}