{
    "format_version": "1.13.0",
    "minecraft:entity": {
        "description": {
            "identifier": "4ks_ring:water_minion",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
            "animations": {
                "dead": "animation.4ks_ring.wminion.dead",
	        "attack": "animation.4ks_ring.wminion.attack"
            },
            "scripts": {
                "animate": [
                    {
                        "dead": "!query.is_alive"
                    },
                    {
                        "attack": "query.is_delayed_attacking"
                    }
                ]
            }
        },
        "component_groups": {
            "minecraft:melee_attack": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:attack": {
                    "damage": 12
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "attack_duration": 1.5,
                    "attack_once": false,
                    "hit_delay_pct": 0.1,
                    "reach_multiplier": 4,
                    "require_complete_path": true,
                    "track_target": false
                }
            },
            "minecraft:ranged_attack": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:attack": {
                    "damage": 16
                },
                "minecraft:behavior.ranged_attack": {
                    "priority": 0,
		    "charge_charged_trigger": 0.05,
                    "attack_interval_min": 1,
                    "attack_interval_max": 3,
                    "attack_radius": 15
                },
                "minecraft:shooter": {
                    "def": "4ks_ring:water_ball"
                }
            }
        },
        "components": {
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            },
            "minecraft:movement": {
                "value": 0.24
            },
            "minecraft:nameable": {},
            "minecraft:type_family": {
                "family": [
                    "minion", "iron_golem"
                ]
            },
	
            "minecraft:collision_box": {
                "width": 0.8,
                "height": 1.5
            },
	    "minecraft:shooter": {
                    "def": "minecraft:arrow"
                },
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {
                "is_amphibious": true,
                "can_pass_doors": true,
                "can_walk": true,
                "can_break_doors": true
            },
            "minecraft:annotation.break_door": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 250,
                "max": 250
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0,
                "breathes_air": true,
                "breathes_water": true
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 1
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 6,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 7
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "within_radius": 25,
                "reselect_targets": true,
                "entity_types": [
                    {
                        "filters": {
                            "any_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "monster"
                                }
                            ]
                        },
                        "max_dist": 15
                    }
                ],
                "must_see": false,
                "must_see_forget_duration": 8
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "minecraft:melee_attack"
                    ]
                }
            },
            "4ks_range": {
                "add": {
                    "component_groups": [
                        "minecraft:melee_attack"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:ranged_attack"
                    ]
                }
            },
            "4ks_shoot": {
                "remove": {
                    "component_groups": [
                        "minecraft:melee_attack"
                    ]
                },
                "add": {
                    "component_groups": [
                        "minecraft:ranged_attack"
                    ]
                }
            }
        }
    }
}