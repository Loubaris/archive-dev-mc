{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.4ks_ring.minion2": {
      "states": {
        "default": {
          "blend_transition": 0.3,
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walking": "q.ground_speed > 0 && q.is_on_ground"
            },
            {
              "attacking": "q.is_delayed_attacking && q.variant == 1"
            },
	    {
              "attacking2": "q.has_target && q.variant == 0"
            }
          ]
        },
        "walking": {
          "blend_transition": 0.3,
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "q.ground_speed <= 0 || !q.is_on_ground"
            },
            {
              "attacking": "q.is_delayed_attacking && q.variant == 1"
            },
	    {
              "attacking2": "q.has_target && q.variant == 0"
            }
          ]
        },
        "attacking": {
          "blend_transition": 0.3,
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "!q.is_delayed_attacking && q.all_animations_finished"
            }
          ]
        },
	"attacking2": {
          "blend_transition": 0.3,
          "animations": [
            "attack2"
          ],
          "transitions": [
            {
              "default": "!q.has_target && q.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}