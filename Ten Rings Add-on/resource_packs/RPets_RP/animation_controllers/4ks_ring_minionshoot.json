{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.4ks_ring.minionshoot": {
      "states": {
        "default": {
          "blend_transition": 0.3,
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walking": "q.ground_speed > 0 && q.is_on_ground"
            },
            {
              "attacking": "query.has_target"
            }
          ]
        },
        "walking": {
          "blend_transition": 0.3,
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "q.ground_speed <= 0 || !q.is_on_ground"
            },
            {
              "attacking": "query.has_target"
            }
          ]
        },
        "attacking": {
          "blend_transition": 0.3,
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "!query.has_target || q.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}