{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.villager_v2.baby.new": {
			"initial_state": "baby",
			"states": {
				"baby": {
					"animations": [
						{
							"baby_transform": "query.is_baby"
						}
					]
				}
			}
		},
		"controller.animation.villager_v2.general.new": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"general",
						{
							"look_at_target": "!query.is_sleeping"
						}
					]
				}
			}
		},
		"controller.animation.villager_v2.move.new": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"move": "query.modified_move_speed"
						}
					],
					"transitions": [
						{
							"get_in_bed": "query.is_sleeping"
						}
					]
				},
				"get_in_bed": {
					"animations": [
						"get_in_bed"
					],
					"transitions": [
						{
							"default": "!query.is_sleeping"
						}
					]
				}
			}
		},
		"controller.animation.villager_v2.raise_arms.new": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"raising": "variable.raise_arms>0"
						}
					]
				},
				"raising": {
					"animations": [
						"raise_arms"
					],
					"transitions": [
						{
							"default": "variable.raise_arms==0"
						}
					]
				}
			}
		}
	}
}