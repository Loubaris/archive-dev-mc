{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.hoglin.baby_scaling.new": {
			"initial_state": "default",
			"states": {
				"baby": {
					"animations": [
						"hoglin_baby_scaling"
					],
					"transitions": [
						{
							"default": "!query.is_baby"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"baby": "query.is_baby"
						}
					]
				}
			}
		},
		"controller.animation.hoglin.look_at_target.new": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"look_at_target"
					]
				}
			}
		},
		"controller.animation.hoglin.walk.new": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						"walk"
					]
				}
			}
		},
		"controller.animation.hoglin.attack.new": {
			"initial_state": "default",
			"states": {
				"attack": {
					"animations": [
						"attack"
					],
					"transitions": [
						{
							"default": "!variable.has_target||variable.attack_time<0"
						}
					]
				},
				"default": {
					"transitions": [
						{
							"attack": "variable.has_target&&variable.attack_time>=0"
						}
					]
				}
			}
		}
	}
}