			"scripts": {
				"pre_animation": [
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.animation_speed = Math.min(0.5, 3.0 * query.modified_move_speed); query.variant == 3;",
					"variable.anim_pos_mod = 49.388962; query.variant == 3;",
					"variable.bob = query.life_time * 20; query.variant == 3;",
					"variable.modified_bob = variable.bob * 0.1 * 57.2958; query.variant == 3;",
					"variable.modified_bob_sin = math.sin(variable.modified_bob); query.variant == 3;",
					"variable.modified_bob_cos = math.cos(variable.modified_bob); query.variant == 3;",
					"variable.pi = 180; query.variant == 3;",
					"variable.halfpi = variable.pi / 2.0; query.variant == 3;",
					"variable.tendril_animation_length = 0.5; query.variant == 3;",
					"variable.head_x_rot = (68.7549 * math.cos(query.modified_distance_moved * variable.anim_pos_mod + variable.halfpi) * math.min(0.35, variable.animation_speed)) + (math.sin(variable.bob * 5.72958) * 0.06); query.variant == 3;",
					"variable.head_z_rot = (17.1887 * math.sin(query.modified_distance_moved * variable.anim_pos_mod) * variable.animation_speed) + (Math.cos(variable.bob * 5.72958) * 0.06); query.variant == 3;",
					"variable.body_x_rot = (57.2958 * math.cos(query.modified_distance_moved * variable.anim_pos_mod) * math.min(0.35, variable.animation_speed)) + (math.cos(variable.bob * 5.72958) * 0.025); query.variant == 3;",
					"variable.body_z_rot = (5.72958 * math.sin(query.modified_distance_moved * variable.anim_pos_mod) * variable.animation_speed) + (math.sin(variable.bob * 5.72958) * 0.025); query.variant == 3;",
					"variable.left_leg_x_rot = 57.2958 * math.cos(query.modified_distance_moved * variable.anim_pos_mod) * variable.animation_speed; query.variant == 3;",
					"variable.right_leg_x_rot = 57.2958 * math.cos(query.modified_distance_moved * variable.anim_pos_mod + variable.pi) * variable.animation_speed; query.variant == 3;",
					"variable.left_arm_x_rot = -(45.8366 * math.cos(query.modified_distance_moved * variable.anim_pos_mod) * variable.animation_speed); query.variant == 3;",
					"variable.right_arm_x_rot = -(45.8366 * math.sin(query.modified_distance_moved * variable.anim_pos_mod) * variable.animation_speed); query.variant == 3;",
					"variable.vibration_phase = query.time_since_last_vibration_detection; query.variant == 3;",
					"variable.tendril_animation = variable.vibration_phase < 0.0 ? 0.0 : 1.0 - (math.min(query.time_since_last_vibration_detection, variable.tendril_animation_length) / variable.tendril_animation_length); query.variant == 3;",
					"variable.left_tendril_x_rot = variable.tendril_animation * (math.cos(variable.bob * 128.9155) * variable.pi * 0.1); query.variant == 3;",
					"variable.right_tendril_x_rot = variable.left_tendril_x_rot * -1; query.variant == 3;",
					"variable.spots_1_alpha = 0.25 * math.cos(variable.bob * 2.578); query.variant == 3;",
					"variable.spots_2_alpha = 0.25 * math.cos(variable.bob * 2.578 + 180.0); query.variant == 3;",
					"variable.tendrils_alpha = variable.tendril_animation; query.variant == 3;",
					"variable.heart_alpha = 0.8 * (1.0 - query.heartbeat_phase); query.variant == 3;",
					"variable.wobble = Math.sin(query.swell_amount * 5730) * query.swell_amount * 0.01 + 1.0;",
					"variable.swelling_scale1 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.4 + 1.0) * variable.wobble;",
					"variable.swelling_scale2 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.1 + 1.0) / variable.wobble;",
					"variable.leg_rot = Math.cos(query.modified_distance_moved * 38.17326) * 80.22 * query.modified_move_speed;",
					"variable.flash = Math.mod(Math.Round(query.swell_amount * 10.0), 2.0);",
					"variable.tcos_right_side = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.tcos_left_side = -variable.tcos_right_side;",
					"variable.attack_head_rot =  Math.sin(variable.attack_time * 180.0) * -37.3;"
				],
