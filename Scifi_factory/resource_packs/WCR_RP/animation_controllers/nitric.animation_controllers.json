{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.nitric.general": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"move": "query.modified_move_speed >= 0.01"
						}
					]
				},
				"move": {
					"animations": [
						"move"
					],
					"transitions": [
						{
							"default": "query.modified_move_speed <= 0.01"
						}
					]
				}
			}
		}
	}
}