{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mini_gun_cannon_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"mini_gun_cannon_detection": "query.get_equipped_item_name == 'mini_gun_cannon' && query.is_using_item == true"
						}
					]
				},
				"mini_gun_cannon_detection": {
					"on_entry": [
						"/tag @p[r=1] add mini_gun_cannon"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}