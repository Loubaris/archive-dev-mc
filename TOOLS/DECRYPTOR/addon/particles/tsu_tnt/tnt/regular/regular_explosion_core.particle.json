{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:regular_explosion_core",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/tsu_tnt/0/particle/cloud"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 40
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 1.5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.5+v.particle_random_1"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)"
			},
			"minecraft:particle_initial_speed": "18*v.particle_random_1",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 3, 0],
				"linear_drag_coefficient": 5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [2, 1.5],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 512,
					"texture_height": 512,
					"uv": ["v.particle_random_4 > 0.5 ? 0 : 256", "v.particle_random_3 > 0.5 ? 0 : 256"],
					"uv_size": [256, 256]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFBC8",
						"0.62": "#FF95291C",
						"1.0": "#FF320B24"
					}
				}
			}
		}
	}
}