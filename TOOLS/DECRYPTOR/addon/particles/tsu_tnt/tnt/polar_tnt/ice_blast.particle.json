{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:ice_blast",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.size_curve": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0, 1, 1]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.scale = 0.6;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 200
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1,2)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random_integer(0,3) * 90"
			},
			"minecraft:particle_initial_speed": "4+v.particle_random_1*2",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.scale * v.size_curve", "v.scale * v.size_curve"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 10],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"max_frame": "math.round(v.particle_random_1 * 10) + 6",
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.01,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFCAFBFF",
						"0.17": "#FFFFFFFF",
						"0.5": "#FFC8E4FF",
						"1.0": "#002EA5FF"
					}
				}
			}
		}
	}
}