{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:toxic_explosion_debris",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/tsu_tnt/0/particle/cloud"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.range_y = 10;variable.range_xz = 15;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 50,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.sin(v.emitter_age*90)*(v.emitter_random_3 >0.5?v.emitter_random_4*-1:v.emitter_random_4)*v.range_xz", "math.abs(math.sin(v.emitter_age*180))*1*(variable.range_y*v.emitter_random_3)", "math.sin(v.emitter_age*90)*(v.emitter_random_2 > 0.5 ? v.emitter_random_1*-1 : v.emitter_random_4 )*v.range_xz"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.particle_random_1/1.9"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1*v.particle_age+0.8", "v.particle_random_1*v.particle_age+0.8"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": ["v.particle_random_4 > 0.5 ? 0 : 128", "v.particle_random_1 > 0.5 ? 0 : 128"],
					"uv_size": [128, 128]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 15,
				"coefficient_of_restitution": 0.1,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00A3FFAF",
						"0.35": "#FF86FF7B",
						"0.67": "#FF56FFAE",
						"1.0": "#0026FF93"
					}
				}
			}
		}
	}
}