{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:toxic_explosion_spill",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/tsu_tnt/0/particle/cloud"
			}
		},
		"curves": {
			"variable.size": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 1, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 6,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 10
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.2, 0],
				"radius": "1+(v.emitter_age/v.emitter_lifetime)*4",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(8,11)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -6, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["4*variable.size", "4*variable.size"],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": ["v.particle_random_4 > 0.5 ? 0 : 128", "v.particle_random_3 > 0.5 ? 0 : 128"],
					"uv_size": [128, 128]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#0022FF00",
						"0.25": "#FF71FF03",
						"0.62": "#FF1FFB39",
						"1.0": "#00F6FFF3"
					}
				}
			}
		}
	}
}