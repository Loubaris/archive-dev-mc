{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:jet_smoke",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"curves": {
			"variable.size_curve": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 1.18, 1.66]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.scale = 0.5;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2.5,3)"
			},
			"minecraft:particle_initial_speed": 0.8,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.scale * v.size_curve", "v.scale * v.size_curve"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [1, 1],
						"step_UV": [0, 1],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.33": "#FFFFA11E",
						"1.0": "#FFFF0000"
					}
				}
			}
		}
	}
}