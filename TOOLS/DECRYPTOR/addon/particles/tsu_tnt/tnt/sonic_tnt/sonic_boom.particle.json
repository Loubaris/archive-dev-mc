				"size": ["10*variable.size", "10*variable.size"],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 32,
					"texture_height": 512,
					"flipbook": {
						"base_UV": [0, "32*5"],
						"size_UV": [32, 32],
						"step_UV": [0, 32],
						"frames_per_second": 8,
						"max_frame": 16,
						"stretch_to_lifetime": true
