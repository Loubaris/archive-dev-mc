{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tsu_tnt:sonic_boom",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/tsu_tnt/0/particle/sonic_explosion2"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 100
			},
