{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cyd_mgspl:blast_impact",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/cyd/mgspl/particle/rocks"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.3;variable.lifetime = 1.0;variable.size_variant = 0.6;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "variable.scale*25"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.4, 0],
				"radius": 0.2,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(variable.particle_random_1+0.3)*variable.lifetime"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_1*360",
				"rotation_rate": 720
			},
			"minecraft:particle_initial_speed": "(variable.particle_random_1*6)+(variable.scale*6)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -9, 0],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size+(variable.size_variant*variable.particle_random_4)-(variable.particle_age*0.4)", "variable.size+(variable.size_variant*variable.particle_random_4)-(variable.particle_age*0.4)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 160,
					"uv": [0, "math.floor(variable.particle_random_4*6)*32"],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 2,
				"collision_radius": 0.25,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#FFADA396",
						"0.39": "#FF666262",
						"0.79": "#174D4B49"
					}
				}
			}
		}
	}
}