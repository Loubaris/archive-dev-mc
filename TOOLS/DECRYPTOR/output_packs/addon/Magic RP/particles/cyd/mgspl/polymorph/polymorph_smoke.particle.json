{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cyd_mgspl:polymorph_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/cyd/mgspl/particle/curly_smoke_glow"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.5;variable.lifetime = 2.0;variable.size_variant = 0.3;variable.age_growth = -0.3;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.5, 0],
				"radius": 0.5,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(variable.particle_random_1+0.3)*variable.lifetime"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_1*360",
				"rotation_rate": "(variable.particle_random_2-0.5)*90"
			},
			"minecraft:particle_initial_speed": "(variable.particle_random_1*1)+1",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "2+variable.particle_random_2*7", 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size+(variable.size_variant*variable.particle_random_4)+(variable.particle_age*variable.age_growth)", "variable.size+(variable.size_variant*variable.particle_random_4)+(variable.particle_age*variable.age_growth)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 192,
					"uv": [0, "math.floor(variable.particle_random_1*3)*64"],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 2,
				"collision_radius": 0.25,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age",
					"gradient": {
						"0.0": "#87C392A0",
						"1.68": "#2BDC1E5E"
					}
				}
			}
		}
	}
}