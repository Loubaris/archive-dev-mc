{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cyd_mgspl:spell_potion",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/cyd/mgspl/particle/flash_2"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.1;variable.lifetime = 0.5;variable.size_variant = 0.1;variable.age_growth = 0.3;variable.radius = 2;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.25
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 1, 0],
				"radius": "variable.radius",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.lifetime"
			},
			"minecraft:particle_initial_speed": "2+(variable.particle_random_1*2)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": "(variable.particle_age*1)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["1*((variable.size+variable.size_variant*variable.particle_random_4)+variable.particle_age*variable.age_growth*1)", "4*((variable.size+variable.size_variant*variable.particle_random_4)+variable.particle_age*variable.age_growth*1)"],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / variable.particle_lifetime",
					"gradient": {
						"0.0": "#C40F551E",
						"0.13": "#FF44D964",
						"0.56": "#FFACF99A",
						"1.0": "#00ACF99A"
					}
				}
			}
		}
	}
}