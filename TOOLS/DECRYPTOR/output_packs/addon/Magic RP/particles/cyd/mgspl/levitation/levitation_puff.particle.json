{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cyd_mgspl:levitation_puff",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/cyd/mgspl/particle/curly_smoke_glow"
			}
		},
		"components": {
