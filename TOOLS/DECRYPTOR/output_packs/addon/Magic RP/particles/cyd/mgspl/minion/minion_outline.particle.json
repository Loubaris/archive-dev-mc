{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cyd_mgspl:minion_outline",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/cyd/mgspl/particle/flash_2"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.2;variable.lifetime = 0.8;variable.size_variant = 0.2;variable.age_growth = 1.0;variable.radius = 2;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 80,
				"max_particles": 800
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": "variable.radius",
				"surface_only": true,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.lifetime"
			},
			"minecraft:particle_initial_speed": "2+(variable.particle_random_1*2)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": "(variable.particle_age*1)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.clamp(((variable.size+variable.size_variant*variable.particle_random_4)+variable.particle_age*variable.age_growth*1),0.1,4)", "math.clamp(((variable.size+variable.size_variant*variable.particle_random_4)+variable.particle_age*variable.age_growth*12),0.1,8)"],
				"facing_camera_mode": "lookat_y",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / variable.particle_lifetime",
					"gradient": {
						"0.0": "#2605471D",
						"0.25": "#FF7EE24A",
						"0.67": "#B005471D",
						"1.0": "#2605471D"
					}
				}
			}
		}
	}
}