			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 1.3;variable.lifetime = 2.9;variable.size_variant = 1.3;variable.age_growth = 0.2;variable.wobble_percent = 0.2;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
