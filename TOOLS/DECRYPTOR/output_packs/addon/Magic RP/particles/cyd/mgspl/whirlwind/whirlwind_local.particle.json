			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.2, 0],
				"radius": 1,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(variable.lifetime, variable.lifetime*1.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_3*360",
				"rotation_rate": "(variable.particle_random_1-0.5)*180"
			},
			"minecraft:particle_initial_speed": "Math.random(4,16)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.2, 0],
				"linear_drag_coefficient": 3,
				"rotation_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(variable.size*(variable.particle_age*variable.age_growth)+(variable.particle_random_3*variable.size_variant))*(0.8+(math.cos(variable.particle_age*240)*variable.wobble_percent))", "(variable.size*(variable.particle_age*variable.age_growth)+(variable.particle_random_3*variable.size_variant))*(0.8+(math.cos(variable.particle_age*240)*variable.wobble_percent))"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 192,
					"uv": [0, "math.floor(variable.particle_random_4*4)*64"],
