{
   "format_version":"1.20.60",
   "minecraft:entity":{
      "description":{
         "identifier":"cyd_mgspl:spell_polymorph_critter",
         "is_spawnable":false,
         "is_summonable":true,
         "is_experimental":false,
         "animations":{
            "expire":"animation.cyd_mgspl.polymorph_expire",
			"death": "animation.cyd_mgspl.polymorph_death"
         },
         "scripts":{
            "animate":[
               {
                  "expire":"query.property('cyd:revert')"
               },
			   {
                  "death":"!query.is_alive"
               }
            ]
         },
         "properties":{
            "cyd:active":{
               "type":"bool",
               "client_sync":true,
               "default":false
            },
            "cyd:revert":{
               "type":"bool",
               "client_sync":true,
               "default":false
            }
         }
      },
      "component_groups":{
         "cyd:despawn":{
            "minecraft:instant_despawn":{
               
            }
         },
         "cyd:entity_spawning":{
            "minecraft:timer":{
               "looping":true,
               "time":1.5,
               "time_down_event":{
                  "event":"evt:active"
               }
            }
         },
         "cyd_mgspl:timedown":{
            "minecraft:timer":{
               "time":20,
               "looping":false,
               "time_down_event":{
                  "event":"evt:revert",
                  "target":"self"
               }
            }
         },
         "cyd:active":{
            "minecraft:behavior.look_at_player":{
               "priority":7,
               "target_distance":6,
               "probability":0.02
            },
            "minecraft:behavior.random_stroll":{
               "priority":7,
               "speed_multiplier":0.7,
               "interval":20,
               "xz_dist":10,
               "y_dist":4
            }
         }
      },
      "components":{
         "minecraft:nameable":{
            
         },
         "minecraft:type_family":{
            "family":[
               "mob",
               "polymorph"
            ]
         },
         "minecraft:movement":{
            "value":0.30
         },
         "minecraft:scale":{
            "value":1.2
         },
         "minecraft:movement.basic":{
            
         },
         "minecraft:jump.static":{
            
         },
         "minecraft:can_climb":{
            
         },
         "minecraft:physics":{
            
         },
         "minecraft:pushable":{
            
         },
         "minecraft:navigation.generic":{
            "is_amphibious":true,
            "can_path_over_water":false,
            "can_break_doors":false,
            "can_swim":false,
            "can_walk":true,
            "avoid_sun":false
         },
         "minecraft:breathable":{
            "total_supply":35,
            "suffocate_time":0
         },
         "minecraft:collision_box":{
            "width":0.5,
            "height":0.5
         },
         "minecraft:health":{
            "value":8
         },
         "minecraft:follow_range":{
            "value":64
         },
         "minecraft:behavior.avoid_mob_type":{
            "priority":3,
            "entity_types":[
               {
                  "filters":{
                     "test":"is_family",
                     "subject":"other",
                     "value":"player"
                  },
                  "max_dist":10,
                  "walk_speed_multiplier":1.2,
                  "sprint_speed_multiplier":1.2
               }
            ]
         }
      },
      "events":{
         "minecraft:entity_spawned":{
            "add":{
               "component_groups":[
                  "cyd:entity_spawning"
               ]
            }
         },
         "minecraft:entity_transformed":{
            "set_property":{
               "cyd:active":true
            },
            "remove":{
               "component_groups":[
                  "cyd:entity_spawning"
               ]
            },
            "add":{
               "component_groups":[
                  "cyd:active"
               ]
            }
         },
         "evt:active":{
            "set_property":{
               "cyd:active":true
            },
            "remove":{
               "component_groups":[
                  "cyd:entity_spawning"
               ]
            },
            "add":{
               "component_groups":[
                  "cyd:active",
                  "cyd_mgspl:timedown"
               ]
            }
         },
         "evt:despawn":{
            "add":{
               "component_groups":[
                  "cyd:despawn"
               ]
            }
         },
         "evt:revert":{
            "set_property":{
               "cyd:revert":true
            }
         }
      }
   }
}