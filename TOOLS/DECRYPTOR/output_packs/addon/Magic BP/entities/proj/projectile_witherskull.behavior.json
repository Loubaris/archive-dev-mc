{
   "format_version":"1.20.60",
   "minecraft:entity":{
      "description":{
         "identifier":"cyd_mgspl:projectile_witherskull",
         "is_spawnable":false,
         "is_summonable":true,
         "is_experimental":false,
         "animations":{
            "on_impact":"animation.cyd_mgspl.witherskull.on_impact",
			"launch": "animation.cyd_mgspl.witherskull.launch"
         },
         "scripts":{
            "animate":[
               {"on_impact":"query.is_sheared"},
			   "launch"
            ]
         }
      },
      "component_groups":{
         "cyd_mgspl:despawn": {
			"minecraft:instant_despawn": {}
		 },
		 "cyd_mgspl:explode":{
            "minecraft:is_sheared":{}
         },
		 "cyd_mgspl:target":{
			 "minecraft:behavior.nearest_attackable_target": {
			  "priority": 2,
			  "entity_types": [
				{
				"filters": {  
					"all_of": [
					  { "test" :  "is_family", "subject" : "other", "value" :  "mob"},
					  { "test": "has_component", "subject": "other", "operator": "not", "value": "minecraft:is_tamed" }
					] 
				},
				"max_dist": 24
				}
			  ]
			 },
			 "minecraft:attack": {
				"damage": 1
			 },
			 "minecraft:behavior.melee_attack": {
				"priority": 3,
				"speed_multiplier": 1,
				"track_target": true
			 }
         },
         "cyd_mgspl:timedown":{
            "minecraft:timer":{
               "time":5,
               "looping":false,
               "time_down_event":{
                  "event":"evt:expire",
                  "target":"self"
               }
            }
         }
      },
      "components":{
         "minecraft:type_family": {
            "family": [
               "projectile",
               "witherskull"
            ]
         },
		 "minecraft:collision_box":{
            "width":0.5,
            "height":0.5
         },
         "minecraft:physics":{
		  "has_collision": true
		 },
         "minecraft:pushable":{
            "is_pushable":false,
            "is_pushable_by_piston":false
         },
		 "minecraft:fire_immune": {},
         "minecraft:movement":{
            "value":0.4
         },
         "minecraft:flying_speed":{
            "value":0.4
         },
         "minecraft:behavior.random_hover":{
            "priority":12,
            "xz_dist":8,
            "y_dist":8,
            "y_offset":-1,
            "interval":1,
            "hover_height":[
               0,
               4
            ]
         },
         "minecraft:navigation.hover":{
            "can_path_over_water":true,
            "can_sink":false,
            "can_pass_doors":false,
            "can_path_from_air":true,
            "avoid_water":true,
            "avoid_damage_blocks":true,
            "avoid_sun":false
         },
         "minecraft:movement.hover":{
			 "max_turn": 20.0
		 },
         "minecraft:jump.static":{},
         "minecraft:can_fly":{},
         "minecraft:follow_range":{
            "value":32,
            "max":32
         },
         "minecraft:target_nearby_sensor": {
          "inside_range": 1.0,
          "outside_range": 3.0,
          "must_see":  true,
          "on_inside_range": {
            "event": "evt:expire",
            "target": "self"
          }
         }
      },
      "events":{
         "minecraft:entity_spawned":{
            "add":{
               "component_groups":["cyd_mgspl:timedown"]
            }
         },
         "minecraft:entity_born":{
            "add":{
               "component_groups":["cyd_mgspl:timedown"]
            }
         },
		 "evt:target":{
            "add":{
               "component_groups":[
                  "cyd_mgspl:target"
               ]
            }
         },
         "evt:expire":{
            "add":{
               "component_groups":[
                  "cyd_mgspl:explode"
               ]
            }
         },
		 "evt:despawn":{
            "add":{
               "component_groups":[
                  "cyd_mgspl:despawn"
               ]
            }
         }
      }
   }
}