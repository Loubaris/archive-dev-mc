    "animation.cyd_mgspl.fireball.launch": {
      "loop": false,
      "timeline": {
        "0.0": ["/playsound cyd_mgspl.fireball_cast @a[r=20]"]
      },
      "animation_length": 1
    },
    "animation.cyd_mgspl.fireball.on_impact": {
      "loop": false,
      "timeline": {
		"0.0": ["/playsound cyd_mgspl.fireball_impact @a[r=25]",
				"/particle cyd_mgspl:fireball_explosion_ex ~ ~ ~",
				"/particle cyd_mgspl:fireball_impact_ember ~ ~ ~",
				"/particle cyd_mgspl:fireball_sparks_small ~ ~ ~",
				"@s evt:despawn"]
      },
      "animation_length": 1
    },
