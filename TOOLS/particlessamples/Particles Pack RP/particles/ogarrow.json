{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "collectibles:ogarrow",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.letter_x1": {
				"type": "linear",
				"input": "variable.particle_random_1",
				"horizontal_range": 1,
				"nodes": [1, 1]
			},
			"variable.letter_y1": {
				"type": "linear",
				"input": "variable.particle_random_1",
				"horizontal_range": 1,
				"nodes": [1.1, 0]
			},
			"variable.letter_x2": {
				"type": "linear",
				"input": "variable.particle_random_1",
				"horizontal_range": 1,
				"nodes": [0, -0.7, 0, 0.73, 0, 0.82, 0, -0.76]
			},
			"variable.letter_y2": {
				"type": "linear",
				"input": "variable.particle_random_1",
				"horizontal_range": 1,
				"nodes": [0, 0.65, 0, 0.66, 0, 0.67, 0, 0.65]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.scale = 5;",
				"per_update_expression": "variable.rotation = variable.emitter_age *-90;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 10
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 2,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.5
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_motion_parametric": {
				"relative_position": ["(variable.particle_random_2 < 0.5 ? variable.letter_x1 - 1 : variable.letter_x2) * math.sin(variable.rotation)  * variable.scale", "(variable.particle_random_2 < 0.5 ? variable.letter_y1 : variable.letter_y2)  * variable.scale", "(variable.particle_random_2 < 0.5 ? variable.letter_x1 - 1 : variable.letter_x2) * math.cos(variable.rotation) * variable.scale"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1 * variable.scale", "0.1 * variable.scale"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 7,
						"max_frame": 6,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_1*variable.particle_age",
					"gradient": {
						"0.0": "#ffFF0000",
						"0.7": "#ff530000",
						"1.83": "#ffFF4B03",
						"2.5": "#ffFF0000"
					}
				}
			}
		}
	}
}