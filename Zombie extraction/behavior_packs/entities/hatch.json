{
    "format_version": "1.8.0",
    "minecraft:entity": {
        "description": {
            "identifier": "sw:hatch",
            "is_spawnable": false,
            "is_experimental": false,
            "is_summonable": true
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "npc",
                    "inac"
                ]
            },
            "minecraft:damage_sensor": [
                {
                    "cause": "all",
                    "deals_damage": false
                }
            ],
            "minecraft:health": {
                "value": 1,
                "max": 1
            },
            "minecraft:collision_box": {
                "width": 2,
                "height": 1
            },
            "minecraft:scale": {
                "value": 1
            },
            "minecraft:interact": [
                {
                    "on_interact": {
                        "filters": {
                            "all_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "player"
                                },
            {
              "test": "has_equipment",
              "domain": "hand",
              "subject": "other",
              "value": "emerald"
            }
                            ]
                        }
                    },
                    "interact_text": "Open",
		    "play_sounds": "note.pling",
                    "add_items": {
                        "table": "loot_tables/entities/key.json"
                    }
                }
            ],
            "minecraft:nameable": {
                "alwaysShow": true,
                "allowNameTagRenaming": true
            },
			    "minecraft:pushable": {
        "is_pushable": false
      },
            "minecraft:physics": {
                "has_gravity": false
            },
            "minecraft:push_through": {
                "value": 0
            },
            "minecraft:knockback_resistance": {
                "value": 1
            }
        },
        "component_groups": {
            "kill": {
                "minecraft:health": {
                    "value": -1
                }
            }
        },
        "events": {
            "kill": {
                "add": {
                    "component_groups": [
                        "kill"
                    ]
                }
            }
        }
    }
}