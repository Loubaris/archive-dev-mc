{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.dimensional_transporter_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"dimensional_transporter_detection": "query.get_equipped_item_name == 'dimensional_transporter' && query.is_using_item == true"
						}
					]
				},
				"dimensional_transporter_detection": {
					"on_entry": [
						"/tag @p[r=1] add dimensional_transporter"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}