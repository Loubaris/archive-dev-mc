{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.heat_sinking_rifle_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"heat_sinking_rifle_detection": "query.get_equipped_item_name == 'heat_sinking_rifle' && query.is_using_item == true"
						}
					]
				},
				"heat_sinking_rifle_detection": {
					"on_entry": [
						"/tag @p[r=1] add heat_sinking_rifle"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}