{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.sniper": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"sniper_detection": "query.get_equipped_item_name == 'sniper' && query.is_using_item == true"
						}
					]
				},
				"sniper_detection": {
					"on_entry": [
						"/tag @p[r=1] add sniper"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}