{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mes_mrhrs.fly_horse.move": {
            "states": {
                "default": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        {
                            "run": "q.ground_speed > 0 && !(query.is_on_ground < 1)"
                        },
                        {
                            "fly": "(query.is_on_ground < 1)"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "run": {
                    "animations": [
                        "run"
                    ],
                    "transitions": [
                        {
                            "default": "q.ground_speed <= 0"
                        },
                        {
                            "fly": "(query.is_on_ground < 1)"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "fly": {
                    "animations": [
                        "fly"
                    ],
                    "transitions": [
                        {
                            "default": "!(query.is_on_ground < 1) && q.ground_speed <= 0"
                        },
                        {
                            "run": "!(query.is_on_ground < 1) && q.ground_speed > 0"
                        }
                    ],
                    "blend_transition": 0.1
                }
            }
        }
    }
}