                "move_custom": "controller.animation.mes_mrhrs.fly_horse.move"
            },
            "geometry": {
                "default": "geometry.mes_mrhrs.hippogriff_horse"
            },
            "render_controllers": [
                "controller.render.default"
            ]
	}
    }
