{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mes_heroes:bulk",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/mes/heroes/particle/flash"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 1.0;variable.lifetime = 0.45;variable.size_variant = 0.0;variable.age_growth = 15;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "1*20"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "1*2",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.lifetime"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_1*360",
				"rotation_rate": "(variable.particle_random_2-0.5)*90"
			},
			"minecraft:particle_initial_speed": 20,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"variable.size+(variable.particle_age*variable.age_growth)",
					"variable.size+(variable.particle_age*variable.age_growth)"
				],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [
						0,
						0
					],
					"uv_size": [
						64,
						64
					]
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 2,
				"collision_radius": 0.25,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#87FFDB00",
						"0.53": "#12FFE700",
						"1.0": "#00FFF500"
					}
				}
			}
		}
	}
}