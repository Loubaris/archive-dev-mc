{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mes_heroes.move": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.3,
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"walk": "q.ground_speed > 0.1"
						}
					]
				},
				"walk": {
					"blend_transition": 0.3,
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"default": "q.ground_speed <= 0.1"
						}
					]
				}
			}
		}
	}
}