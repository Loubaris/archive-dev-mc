{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "nitric:unicorn1_wings",
      "materials": {
        "default": "zombie"
      },
      "textures": {
        "default": "textures/entity/unicorn1_wings"
      },
      "geometry": {
        "default": "geometry.unicorn_adult"
      },
      "spawn_egg": {
                    "base_color": "#e3dfb8",
                    "overlay_color": "#ea41f0"
                  },
      "scripts": {
	"should_update_bones_and_effects_offscreen": false,
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": [
          "move_custom"
        ]
      },
      "animations": {
        "fly": "animation.unicorn_adult.fly",
        "walk": "animation.unicorn_adult.walk",
        "move_custom": "controller.animation.unicorn_adult.move"
      },
"sound_effects": {
                "unicorn_run": "nitric.unicorn_run",
		"unicorn_fly": "nitric.unicorn_fly"
            },
      "render_controllers": [ "controller.render.default" ]
    }
  }
}
