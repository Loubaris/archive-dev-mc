{
    "format_version" : "1.8.0",
   "minecraft:entity" : {
      "description": {
         "identifier": "ninja:intro",
         "is_spawnable" : false,
         "is_experimental" : false,
         "is_summonable" : true
      },
      "components" : {
            "minecraft:type_family": {
                "family": [ "npc" ]
                },
            "minecraft:health": {
                "value": 1,
                "max": 1
                },
            "minecraft:collision_box": {
                "width": 4,
                "height": 2.5
                },
	    "minecraft:scale": {
                "value": 1.5
            },
            "minecraft:nameable" : {
                "alwaysShow" : true,
                "allowNameTagRenaming" : true
                },
            "minecraft:loot": {
                "table": "loot_tables/entities/intro.json"
            },
            "minecraft:push_through": {
                "value": 1
            },
            "minecraft:interact": [
                {
                    "on_interact": {
                        "filters": {
                            "all_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "player"
                                }
                            ]
                        },
                        "event": "kill"
                    },
                    "interact_text": "§aClick to start the map"
                }
            ],
            "minecraft:knockback_resistance": {
                "value": 1
            }
        },
        "component_groups": {
            "kill": {
                "minecraft:health": {
                    "value": -1
                }
            }
        },
        "events": {
            "kill": {
                "add": {
                    "component_groups": [
                        "kill"
                    ]
                }
            }
        }
    }
}