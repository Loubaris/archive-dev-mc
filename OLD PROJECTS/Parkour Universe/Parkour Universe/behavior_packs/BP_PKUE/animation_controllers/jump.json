{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.boots": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "clickitem": "(query.is_jumping)"
                        }
                    ]
                },
                "clickitem": {
                    "on_entry": [
                        "/particle pk:oxygen ~ ~ ~ ",
			"/execute @a[hasitem={location=slot.weapon.mainhand,item=feather}] ~ ~ ~ detect ~ ~-1 ~ air 0 tag @s add jumping"
                    ],
                    "transitions": [
                        {
                            "default": "(!query.is_jumping)"
                        }
                    ]
                }
            }
        }
    }
}