{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"used": "query.is_riding && variable.attack_time"
						}
					]
				},
				"used": {
					"on_entry": [
						"/tag @s[scores={ride=0..}] add attacking"
					
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}