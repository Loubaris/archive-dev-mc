{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mob_mask": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"used": "query.get_equipped_item_name == 'mob_mask' && query.is_using_item == true"
						}
					]
				},
				"used": {
					"on_entry": [
						"/tag @s add usedmask"	
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}