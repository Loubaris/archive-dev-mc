{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:cow",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:masked": {
	"minecraft:loot": {
            	"table": "loot_tables/entities/mask.json"
      	    },
	"minecraft:rideable": {
        "seat_count": 1,
        "family_types": [
          "player"
        ],
        "seats": {
          "position": [
            0.0,
            1.105,
            0.0
          ]
        },
        "interact_text": "action.interact.ride.horse"
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:is_tamed": {},
      "minecraft:horse.jump_strength": {
        "value": {
          "range_min": 0.7,
          "range_max": 0.8
        }
      },
      "minecraft:input_ground_controlled": {},
      "minecraft:can_power_jump": {},
      "minecraft:behavior.player_ride_tamed": {},
      "minecraft:flying_speed": {
        "value": 0.02
      }
      },
      "minecraft:cow_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": "wheat",
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 6,
          "speed_multiplier": 1.1
        }
      },
      "minecraft:cow_adult": {
