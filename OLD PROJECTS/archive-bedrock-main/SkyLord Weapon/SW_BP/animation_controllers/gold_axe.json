{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.gold_axe_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"axe_detection": "query.get_equipped_item_name == 'sw_gold_axe' && query.is_using_item == true"
						}
					]
				},
				"axe_detection": {
					"on_entry": [
						"/tag @p[r=1,rx=20,rxm=-7] add gold_axe_a"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}