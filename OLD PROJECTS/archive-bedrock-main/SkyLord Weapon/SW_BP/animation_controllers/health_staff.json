{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.health_staff_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"health_staff_detection": "query.get_equipped_item_name == 'health_staff' && query.is_using_item == true"
						}
					]
				},
				"health_staff_detection": {
					"on_entry": [
						"/effect @p regeneration 2 255 true",
						"/playsound bubble.pop @p",
						"/particle sw:heart_2 ~ ~2 ~",
						"/particle sw:heart_2 ^ ^2 ^1",
						"/clear @p sw:health_staff 0 1"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}