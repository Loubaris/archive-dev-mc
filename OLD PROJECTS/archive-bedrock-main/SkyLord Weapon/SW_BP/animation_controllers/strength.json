{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.strength_staff_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"strength_staff_detection": "query.get_equipped_item_name == 'strength_staff' && query.is_using_item == true"
						}
					]
				},
				"strength_staff_detection": {
					"on_entry": [
						"/effect @p strength 15 2 true",
						"/playsound bubble.pop @p",
						"/particle sw:explosion ~ ~2 ~",
						"/clear @p sw:strength_staff 0 1"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}