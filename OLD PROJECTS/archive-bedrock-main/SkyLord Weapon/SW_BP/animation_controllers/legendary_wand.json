{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.legendary_wand_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"legendary_wand_detection": "query.get_equipped_item_name == 'magic_wand' && query.is_using_item == true"
						}
					]
				},
				"legendary_wand_detection": {
					"on_entry": [
						"/scoreboard players random @p[r=1,tag=!wand] wandluck 1 3",
						"/tag @p[r=1,rx=20,rxm=-7] add wand"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}