{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.tnt_wand_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"tnt_wand_detection": "query.get_equipped_item_name == 'tnt_wand' && query.is_using_item == true"
						}
					]
				},
				"tnt_wand_detection": {
					"on_entry": [
						"@s sp:n_tnt_shoot"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}