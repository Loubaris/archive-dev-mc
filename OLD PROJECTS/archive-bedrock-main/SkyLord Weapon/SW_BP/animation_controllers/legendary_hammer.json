{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.legendary_hammer_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"legendary_hammer_detection": "query.get_equipped_item_name == 'legendary_hammer' && query.is_using_item == true"
						}
					]
				},
				"legendary_hammer_detection": {
					"on_entry": [
						"/tag @p[r=1,rx=20,rxm=-7] add legendary_hammer_a"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}