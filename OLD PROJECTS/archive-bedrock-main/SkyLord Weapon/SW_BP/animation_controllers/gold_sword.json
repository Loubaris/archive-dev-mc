{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.gold_sword_controller": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"gold_sword_detection": "query.get_equipped_item_name == 'sw_gold_sword' && query.is_using_item == true"
						}
					]
				},
				"gold_sword_detection": {
					"on_entry": [
						"/tag @p[r=1,rx=20,rxm=-7] add gold_sword_a"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}