    "controller.animation.ultra_attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'ultra_sword' && variable.attack_time" } ],
	  "on_entry": [
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ effect @s instant_damage 1 1 true"
	  ]
