						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(-4*math.pow((variable.particle_age/variable.particle_lifetime)-0.5,2)+1)*16",
