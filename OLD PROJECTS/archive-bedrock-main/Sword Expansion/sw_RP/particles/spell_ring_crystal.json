{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sw:spell_ring_crystal",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/Ice_Circle"
			}
		},
		"components": {
