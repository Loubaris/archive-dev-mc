    "controller.animation.poison_attacking": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'poison_sword' && variable.attack_time" } ],
	  "on_entry": [
            "/execute @e[type=!player,type=!item,r=6] ~ ~ ~ effect @s poison 10 3 true",
	    "/execute @e[type=!player,type=!item,r=6,type=ender_dragon] ~ ~ ~ kill @s"
	  ]
        },
