{
	"format_version": "1.16.0",
	"minecraft:entity": {
		"description": {
			"identifier": "pc:rat",
			"is_summonable": true,
			"is_spawnable": true,
			"is_experimental": false
		},
		"component_groups": {
			"pc:angry": {
				"minecraft:angry": {
					"duration": 10,
					"broadcast_anger": true,
					"broadcast_range": 20,
					"calm_event": {
						"event": "minecraft:on_calm",
						"target": "self"
					}
				},
				"minecraft:on_target_acquired": {},
				"minecraft:scale": {
					"value": 0.8
				}
			}
		},
		"components": {
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:can_climb": {},
			"minecraft:behavior.float": {
				"priority": 0
			},
			"minecraft:jump.static": {},
			"minecraft:behavior.hurt_by_target": {
				"priority": 1
			},
			"minecraft:behavior.look_at_player": {
				"priority": 7,
				"look_distance": 6,
				"probability": 0.02
			},
			"minecraft:behavior.random_stroll": {
				"priority": 8,
				"speed_multiplier": 1
			},
			"minecraft:behavior.random_look_around": {
				"priority": 5
			},
			"minecraft:movement": {
				"value": 0.3
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true,
				"avoid_damage_blocks": true,
				"can_walk": true
			},
			"minecraft:movement.basic": {},
			"minecraft:leashable": {
				"soft_distance": 4,
				"hard_distance": 6,
				"max_distance": 10
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"filters": {
							"test": "in_lava",
							"subject": "self",
							"operator": "==",
							"value": true
						},
						"cause": "lava",
						"damage_per_tick": 4
					}
				]
			},
			"minecraft:nameable": {},
			"minecraft:scale": {
				"value": 0.8
			},
			"minecraft:collision_box": {
				"width": 0.4,
				"height": 0.4
			},
			"minecraft:behavior.melee_attack": {
				"priority": 5
			},
			"minecraft:attack": {
				"damage": 1
			},
			"minecraft:experience_reward": {
				"on_death": "query.last_hit_by_player ? 5 : 5"
			},
			"minecraft:health": {
				"value": 10,
				"max": 10
			}
		},
		"events": {
			"minecraft:become_angry": {
				"remove": {
					"component_groups": [
						"pc:rat"
					]
				},
				"add": {
					"component_groups": [
						"pc:angry"
					]
				}
			},
			"minecraft:on_calm": {
				"remove": {
					"component_groups": [
						"pc:angry"
					]
				},
				"add": {
					"component_groups": [
						"pc:rat"
					]
				}
			}
		}
	}
}