{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.extincteur": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"extincteur_detection": "query.get_equipped_item_name == 'extincteur' && query.is_using_item == true"
						}
					]
				},
				"extincteur_detection": {
					"on_entry": [
						"/particle pc:extincteur ^ ^-0.5 ^3",
						"/fill ^-2 ^-3 ^ ^2 ^3 ^4 air 0 replace fire"
					],
					"transitions": [ { "default": "(1.0)" } ]
				}
			}
		}
	}
}