{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ice_wand": {
      "states": {
        "default": {
          "transitions": [ { "click1": "query.get_equipped_item_name == 'ice_wand' && query.is_using_item" } ],
          "on_entry": [
	    "/tag @p[r=1] add ice_wand"
          ]
        },
        "click1": {
          "transitions": [ { "default": "query.get_equipped_item_name == 'ice_wand' && query.is_using_item" } ],
          "on_entry": [
	    "/tag @p[r=1] add ice_wand"			
          ]
        }
      }
    },
    "controller.animation.walk": {
      "states": {
        "default": {
          "transitions": [ { "walking": "(1.0)" } ],
          "on_entry": [
            "/function commands"
          ]
        },
        "walking": {
          "transitions": [ { "default": "(1.0)" } ],
          "on_entry": [
            "/function commands"
          ]
        }
      }
    }
  }
}