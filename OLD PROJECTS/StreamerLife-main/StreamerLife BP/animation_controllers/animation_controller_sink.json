{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sink": {
      "states": {
        "default": {
          "transitions": [
            {
              "animation": "query.skin_id == 5"
            },
            {
              "animation2": "query.skin_id == 6"
            }
          ]
        },
        "animation": {
          "transitions": [
            {
              "default": "query.skin_id != 5"
            }
          ],
          "on_entry": [
            "/function place",
            "/playanimation @s animation.sink.close",
            "@s cypress:flow"
          ]
        },
        "animation2": {
          "transitions": [
            {
              "default": "query.skin_id != 6"
            }
          ],
          "on_entry": [
            "/function place",
            "/playanimation @s animation.sink.open"
          ]
        }
      }
    }
  }
}
