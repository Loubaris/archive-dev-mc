{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.furniture": {
			"states": {
				"default": {
					"transitions": [
						{
							"placing": "query.skin_id == 1"
						},
						{
							"rotate_right": "query.skin_id == 2"
						},
						{
							"moving": "query.skin_id == 3"
						},
						{
							"rotate_left": "query.skin_id == 4"
						}
					]
				},
				"placing": {
					"transitions": [
						{
							"default": "query.skin_id != 1"
						}
					],
					"on_entry": [
						"/function place",
						"@s bridge:remove_command_id_1"
					]
				},
				"rotate_right": {
					"transitions": [
						{
							"default": "query.skin_id != 2"
						}
					],
					"on_entry": [
						"/function rotate_right",
						"@s bridge:remove_command_id_2"
					]
				},
				"moving": {
					"transitions": [
						{
							"default": "query.skin_id != 3"
						}
					],
					"on_entry": [
						"/function moving",
						"@s bridge:remove_command_id_3"
					]
				},
				"rotate_left": {
					"transitions": [
						{
							"default": "query.skin_id != 4"
						}
					],
					"on_entry": [
						"/function rotate_left",
						"@s bridge:remove_command_id_4"
					]
				}
			}
		}
	}
}