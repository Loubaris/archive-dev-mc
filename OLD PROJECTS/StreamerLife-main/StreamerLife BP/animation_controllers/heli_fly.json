{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.heli_on": {
            "states": {
                "default": {
                    "transitions": [{
                        "fighter": "(1.0)"
                    }],
                    "on_entry": [
                        "/tag @s add rider"
                    ]
                },
                "fighter": {
                    "transitions": [{
                        "default": "query.has_rider"
                    }],
                    "on_entry": [
                        "/function helicopter"
                    ]
                }
            }
        }
    }
}