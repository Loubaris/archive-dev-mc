{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.toilet": {
            "states": {
                "default": {
                    "transitions": [{
                            "animation": "query.has_rider"
                        },
                        {
                            "animation2": "!query.has_rider"
                        }
                    ]
                },
                "animation": {
                    "transitions": [{
                        "default": "!query.has_rider"
                    }],
                    "on_entry": [
                        "/function place",
                        "/playanimation @s animation.toilet.open"
                    ]
                },
                "animation2": {
                    "transitions": [{
                        "default": "query.has_rider"
                    }],
                    "on_entry": [
                        "/function place",
                        "/playanimation @s animation.toilet.close"
                    ]
                }
            }
        }
    }
}