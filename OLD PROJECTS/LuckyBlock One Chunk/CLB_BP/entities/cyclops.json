{
    "format_version": "1.16.0",
    "minecraft:entity": {
        "description": {
            "identifier": "nitric:cyclops",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            },
            "minecraft:navigation.walk": {
				"can_path_over_water": true,
				"avoid_sun": false,
				"avoid_water": true
			},
            "minecraft:nameable": {},
            "minecraft:type_family": {
                "family": [
                    "cyclops",
                    "mob"
                ]
            },
            "minecraft:collision_box": {
                "width": 1.4,
                "height": 2.3
            },
            "minecraft:movement.basic": {},
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:annotation.break_door": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 50,
                "max": 50
            },
            "minecraft:scale": {
                "value": 2
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [{
                    "filters": {
                        "test": "in_lava",
                        "subject": "self",
                        "operator": "==",
                        "value": true
                    },
                    "cause": "lava",
                    "damage_per_tick": 4
                }]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0,
                "breathes_air": true,
                "breathes_water": true
            },
            "minecraft:attack": {
                "damage": 10
            },
            "minecraft:loot": {
                "table": "loot_tables/nitric/cyclops.json"
            },
            "minecraft:despawn": {
                "despawn_from_distance": {}
            },
            "minecraft:behavior.equip_item": {
                "priority": 2
            },
            "minecraft:behavior.melee_attack": {
                "priority": 3
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "speed_multiplier": 1
            },
            "minecraft:behavior.look_at_player": {
                "priority": 8,
                "look_distance": 6,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "must_see": true,
                "reselect_targets": true,
                "within_radius": 25.0,
                "must_see_forget_duration": 17.0,
                "entity_types": [{
                    "filters": {
                        "any_of": [{
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        }]
                    },
                    "max_dist": 35
                }]
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "nitric:random_attack"
                    ]
                }
            },
            "nitric:random_attack": {
                "randomize": [{
                        "weight": 50,
                        "add": {
                            "component_groups": [
                                "nitric:attack_1"
                            ]
                        }
                    },
                    {
                        "weight": 50,
                        "add": {
                            "component_groups": [
                                "nitric:attack_2"
                            ]
                        }
                    }
                ],
                "remove": {
                    "component_groups": [
                        "nitric:random_attack"
                    ]
                }
            },
            "nitric:attack_finished": {
                "add": {
                    "component_groups": [
                        "nitric:random_attack"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "nitric:attack_1",
                        "nitric:attack_2"
                    ]
                }
            }
        }
    }
}