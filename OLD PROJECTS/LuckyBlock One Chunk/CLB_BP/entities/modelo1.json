{
    "format_version": "1.16.0",
    "minecraft:entity": {
        "description": {
            "identifier": "nitric:modelo1",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            },
            "minecraft:navigation.walk": {
				"can_path_over_water": true,
				"avoid_sun": false,
				"avoid_water": true
			},
            "minecraft:nameable": {},
            "minecraft:type_family": {
                "family": [
                    "modelo",
                    "mob"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.0
            },
            "minecraft:movement.basic": {},
            "minecraft:movement": {
                "value": 0.2
            },
            "minecraft:annotation.break_door": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 10,
                "max": 10
            },
            "minecraft:scale": {
                "value": 1
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [{
                    "filters": {
                        "test": "in_lava",
                        "subject": "self",
                        "operator": "==",
                        "value": true
                    },
                    "cause": "lava",
                    "damage_per_tick": 4
                }]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 10,
                "breathes_air": true,
                "breathes_water": false
            },
            "minecraft:attack": {
                "damage": 10
            },
            "minecraft:loot": {
                "table": "loot_tables/nitric/modelo1.json"
            },
            "minecraft:despawn": {
                "despawn_from_distance": {}
            },
            //"minecraft:behavior.equip_item": {
            //    "priority": 2
            //},
            "minecraft:behavior.melee_attack": {
                "priority": 3
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "speed_multiplier": 1
            },
            "minecraft:behavior.look_at_player": {
                "priority": 8,
                "look_distance": 6,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "must_see": true,
                "reselect_targets": true,
                "within_radius": 25.0,
                "must_see_forget_duration": 17.0,
                "entity_types": [{
                    "filters": {
                        "any_of": [{
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        }]
                    },
                    "max_dist": 35
                }]
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        }
    }
}