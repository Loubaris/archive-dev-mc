{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.nitric.utils": {
			"initial_state" : "default",
			"states": {
				"default": {
					"transitions": [
						{
							"walk": "query.ground_speed > 0.1"
						}
					]
				},
				"walk": {
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"default": "query.ground_speed == 0"
						}
					]
				}
			}
		},
		"controller.animation.nitric.attack": {
			"initial_state" : "default",
			"states": {
				"default": {
					"transitions": [
						{
							"attack": "variable.attack_time"
						}
                    ]
				},
				"attack": {
                    "animations": [
						"attack"
                    ],
					"transitions": [
						{
							"default": "!variable.attack_time && query.all_animations_finished"
						}
					]
				}
			}
		}
	}
}