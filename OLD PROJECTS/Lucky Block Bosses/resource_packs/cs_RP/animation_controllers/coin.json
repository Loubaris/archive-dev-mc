{
  "format_version": "1.10.0",
  "animation_controllers": {
     "controller.animation.coin": {
        "initial_state": "default",
        "states": {
          "default": {
	    "animations": [
              "idle"
            ],
            "transitions": [
              {
                "walk": "q.modified_move_speed > 0.05"
              }
            ],
            "blend_transition": 0.1
          },
          "walk": {
            "transitions": [
              {
                "default": "q.modified_move_speed <= 0.05"
              }
            ],
            "blend_transition": 0.1
          }
        }
     }
  }
}