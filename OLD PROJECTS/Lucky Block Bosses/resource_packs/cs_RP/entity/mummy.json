{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
      "description": {
          "identifier": "cs:mummy",
          "materials": {
              "default": "skeleton"
          },
          "textures": {
              "default": "textures/entity/monsters/mummy"
          },
          "geometry": {
              "default": "geometry.mummy"
          },
          "animations": {
            "walk": "animation.mummy.walk",
            "idle": "animation.mummy.idle",
            "attack1": "animation.mummy.attack1",
            "attack2": "animation.mummy.attack2",
	    "attack_controller": "controller.animation.mummy"
          },
          "scripts": {
            "pre_animation": [
              "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
            ],
            "animate": [
              "attack_controller"
            ]
          },
          "render_controllers": ["controller.render.basic"],
          "spawn_egg": {
              "base_color": "#52443b",
              "overlay_color": "#b3927d"
          }
      }
  }
}
