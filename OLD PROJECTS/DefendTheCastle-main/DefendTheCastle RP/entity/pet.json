{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
      "description": {
          "identifier": "cypress:pet",
          "materials": {
              "default": "skeleton"
          },
          "textures": {
              "default": "textures/entity/orc/cg_pet"
          },
          "geometry": {
              "default": "geometry.pet"
          },
          "animations": {
            "walk": "animation.pet.walk",
            "idle": "animation.pet.idle",
            "attack": "animation.pet.attack",
            "attack_controller": "controller.animation.pet.attack",
            "move_controller": "controller.animation.orc.move"
          },
          "scripts": {
            "pre_animation": [
              "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
            ],
            "animate": [
              "move_controller",
              "attack_controller"
            ]
          },
          "render_controllers": ["controller.render.basic"],
          "spawn_egg": {
              "base_color": "#52443b",
              "overlay_color": "#b3927d"
          }
      }
  }
}
