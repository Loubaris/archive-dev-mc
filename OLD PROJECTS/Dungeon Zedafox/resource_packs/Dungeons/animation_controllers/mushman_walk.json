{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mushman_walk": {
			"states": {
				"default": {
					"animations": [
						"look_at_target",
						{
							"walk": "query.modified_move_speed*1.6"
						}
					],
					"blend_transition": 0.5,
					"transitions": [
						{
							"roar": "query.is_roaring"
						}
					]
				},
				"walk": {
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}