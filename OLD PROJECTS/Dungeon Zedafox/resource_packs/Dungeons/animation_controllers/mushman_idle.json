{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mushman_idle": {
			"states": {
				"default": {
					"transitions": [
						{
							"idle": "math.random(0, 600) < 1.0"
						}
					],
					"blend_transition": 0.2
				},
				"idle": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}