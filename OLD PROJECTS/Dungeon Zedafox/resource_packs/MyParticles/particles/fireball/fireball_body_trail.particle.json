{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ycar:fireball_main",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.modifier": {
				"type": "bezier_chain",
				"input": "v.particle_age",
				"nodes": {
					"0.08": {
						"value": 2.06,
						"slope": 0
					},
					"1.0": {
						"value": 1.38,
						"slope": 0.15
					}
				}
			},
			"variable.length": {
				"type": "bezier_chain",
				"input": "v.particle_age",
				"nodes": {
					"0.0": {
						"value": 1,
						"slope": 0
					},
					"1.0": {
						"value": 1,
						"slope": 0
					},
					"0.85": {
						"value": 2.19,
						"slope": -3.95
					}
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 999
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": ["(v.particle_random_4-0.5)*0.5", 0, "-v.particle_random_3*10"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.oscillate = (v.particle_random_2<0.5?-1:1)*math.cos(20+v.particle_age*500)*20;v.oscillate2 = (v.particle_random_3<0.5?-1:1)*math.cos(20+v.particle_age*500)*20;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 5
			},
			"minecraft:particle_initial_spin": {
				"rotation": 45,
				"rotation_rate": "math.random(-200,200)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.oscillate2", "v.oscillate", 6],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1*v.modifier", "0.1*v.modifier"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [3, 11],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#7AFFCD5F",
						"0.09": "#F0FF8816",
						"0.16": "#618A2106"
					}
				}
			}
		}
	}
}