{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:music_notes_d",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/entity/music/music_b"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.15;variable.lifetime = 5;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.sin(variable.emitter_age*70-90)*0.25", 0, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_1*variable.lifetime"
			},
			"minecraft:particle_initial_speed": 0.4,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_3-0.5)", 1, "(variable.particle_random_4-0.5)"],
				"linear_drag_coefficient": 0.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)", "variable.size*(variable.particle_random_1*variable.lifetime-variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 2048,
					"texture_height": 2048,
					"flipbook": {
						"base_UV": [0, 1226],
						"size_UV": [408, 407],
						"step_UV": [408, 0],
						"frames_per_second": 5,
						"max_frame": 5,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_lifetime-variable.particle_age",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"1.28": "#FFFFFFFF",
						"2.44": "#FFF9F1BA",
						"4.0": "#FFA8EFFF"
					}
				}
			}
		}
	}
}