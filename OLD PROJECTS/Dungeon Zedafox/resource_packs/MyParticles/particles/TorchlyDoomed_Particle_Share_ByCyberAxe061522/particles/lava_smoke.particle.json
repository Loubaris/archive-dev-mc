{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:lava_smoke",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.1;variable.lifetime = 2.2;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, "math.sin(variable.emitter_age*-100+190)*3", 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(variable.particle_random_1*variable.lifetime)*2"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_3-1.2)", -0.9, "(variable.particle_random_4-1.2)"],
				"linear_drag_coefficient": 0.01
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size*(variable.particle_random_1*variable.lifetime+variable.particle_age)", "variable.size*(variable.particle_random_1*variable.lifetime+variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [40, 80],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_random_1*variable.lifetime)+variable.particle_age",
					"gradient": {
						"0.0": "#FFFFFC00",
						"1.28": "#FFC30000",
						"2.44": "#FFC5C5C5",
						"4.0": "#FF3F3F3F"
					}
				}
			}
		}
	}
}