{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:fireplace_smoke",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.2;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1,
				"max_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random_integer(1, 4.0)"
			},
			"minecraft:particle_initial_speed": "Math.random(0.5, 1.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0.5, 0.75, 0.3],
				"linear_drag_coefficient": 1.7
			},
			"minecraft:particle_kill_plane": [0, 320, 0, 0],
			"minecraft:particle_appearance_billboard": {
				"size": ["((variable.size + variable.particle_age)*variable.entity_scale) / 20", "((variable.size + variable.particle_age)*variable.entity_scale) / 20"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"uv": [0, "12 * (0.08333333333333333 * (12 * (1.3333333333333333 * (Math.floor(variable.particle_random_2 * 12)))))"],
					"uv_size": [16, 15.9996]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.entity_scale + variable.particle_age",
					"gradient": {
						"0.0": "#ffF9F03D",
						"1.45": "#ffE7E9A7",
						"3.8": "#ff9BE2FF",
						"5.0": "#FF036BAD"
					}
				}
			}
		}
