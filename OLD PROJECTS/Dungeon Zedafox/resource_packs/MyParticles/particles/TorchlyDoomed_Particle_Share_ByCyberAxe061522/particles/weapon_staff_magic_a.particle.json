{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:weapon_staff_magic_a",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 3,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 10
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "minecraft:glass", "minecraft:glass_pane", "minecraft:glass_bottle", "minecraft:stained_glass_pane"],
			"minecraft:particle_initial_speed": 0.01,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.clamp((0.01+variable.particle_age), 0.00, 0.01)", "math.clamp((0.01+variable.particle_age), 0.00, 0.05)", "math.clamp((0.01+variable.particle_age), 0.00, 0.01)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.clamp((variable.particle_age-variable.particle_random_1)/5, 0.1, 5.0)", "math.clamp((variable.particle_age-variable.emitter_random_1)/50, 0.1, 0.5)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 16],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 5,
						"max_frame": 1,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age*variable.particle_age",
					"gradient": {
						"0.0": "#FF280988",
						"0.55": "#FF6C0049",
						"1.4000000000000001": "#FF320052",
						"2.5": "#FF1D0026",
						"3.5": "#C4950073",
						"4.55": "#C4492172",
						"5.0": "#3B7100D0"
					}
				}
			}
		}
	}
}