					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [48, 48]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.1,
				"coefficient_of_restitution": 0.5,
				"collision_radius": 0.01
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_age * variable.particle_lifetime)/0.5",
					"gradient": {
						"0.0": "#3BFF0F00",
						"1.5": "#87060000",
						"3.0": "#66FF0000"
					}
