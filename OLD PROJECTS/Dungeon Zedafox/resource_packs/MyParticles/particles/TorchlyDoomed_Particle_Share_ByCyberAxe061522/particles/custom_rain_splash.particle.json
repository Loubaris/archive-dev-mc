{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:custom_rain_splash_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"splash": {
			"particle_effect": {
			"effect": "minecraft:water_splash_particle",
			"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_manual": {
        "max_particles": 150
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1,
				"expiration_expression": 0
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, -0.10, 0],
				"radius": 0.1,
				"direction": [0, -0.001, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.Random(10, 120)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "minecraft:glass_pane"],
			"minecraft:particle_initial_speed": "0.05+Math.random(0, 0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.001, 0],
				"linear_drag_coefficient": 7
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.75+variable.particle_random_1/64", "0.5+variable.particle_random_1/64"],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": ["8 * (0.125 * (8 * (0.125 * (math.floor(variable.particle_random_2*7)*8))))", 88],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 1,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.99,
				"coefficient_of_restitution": 0.98,
				"collision_radius": 0.01,
				"expire_on_contact": false,
				"events": [
          {
            "event": "splash",
            "min_speed": 0.5
          },
          {
            "event": "splash",
            "min_speed": 0.5
          },
          {
            "event": "splash",
            "min_speed": 0.5
          }
        ]
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_age*variable.particle_lifetime)/4",
					"gradient": {
						"0.0": "#335C6F78",
						"72.5": "#297492B0",
						"135.0": "#174D7E87",
						"145.0": "#409C9797",
						"157.5": "#26657D91",
						"210.0": "#1C3B656F",
						"250.0": "#294A6E7B"
					}
				}
			}
		}
	}
}