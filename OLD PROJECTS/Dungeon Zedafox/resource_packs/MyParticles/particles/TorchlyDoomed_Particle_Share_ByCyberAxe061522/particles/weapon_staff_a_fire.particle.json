{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:weapon_staff_a_fire",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/fireplace_a"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2,
				"max_particles": 4
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.75
			},
			"minecraft:emitter_shape_point": {
				"direction": [0.01, 0.1, 0.02]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.75, 2.2)"
			},
			"minecraft:particle_initial_speed": 0.3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0.02, 0.05, 0.02],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.3*variable.entity_scale", "0.3*variable.entity_scale"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 2560,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [256, 512],
						"step_UV": [0, 512],
						"frames_per_second": 5,
						"max_frame": 5,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age+variable.emitter_random_1",
					"gradient": {
						"0.0": "#FFF6E500",
						"1.0": "#FFFFFFFF",
						"2.0": "#FF481C02"
					}
				}
			}
		}
