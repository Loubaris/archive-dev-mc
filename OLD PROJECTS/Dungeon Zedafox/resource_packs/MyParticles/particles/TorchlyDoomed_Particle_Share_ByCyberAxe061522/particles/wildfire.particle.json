{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olcdf:wildfire",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/flame_atlas"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.4, 0],
				"radius": 1.5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1, 1.4)"
			},
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_age)*3", 0.2, "(variable.particle_age)*3"],
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.5*variable.particle_age", "0.5*variable.particle_age"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 512,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"max_frame": 32,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.entity_scale + variable.particle_age",
					"gradient": {
						"0.0": "#700404",
						"0.6000000000000001": "#fd0d0d",
						"0.75": "#0d0114",
						"1.71": "#f5fc0b",
						"1.9200000000000004": "#5a0776",
						"2.37": "#1a011d"
					}
				}
			}
		}
	}
}