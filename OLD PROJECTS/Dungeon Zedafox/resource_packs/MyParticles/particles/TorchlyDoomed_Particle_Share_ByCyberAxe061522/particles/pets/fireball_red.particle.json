{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:fireball_red",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/flame_atlas_b"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 80
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_point": {
				"offset": [0.1, 0, 0],
				"direction": [0, 0, "-Math.clamp(variable.particle_age, 0.01, 0.5)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.3, 60)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": "0+Math.clamp(variable.particle_age*20, 4, 20.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1-0.5)", 0, "(variable.particle_random_1-0.2)"],
				"linear_drag_coefficient": "Math.clamp(variable.particle_age, 0.01, 0.5)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.clamp(1.01*variable.particle_age, 0.01, 0.75)", "Math.clamp(1.01*variable.particle_age, 0.01, 0.75)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 512,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 10,
						"max_frame": 32,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.1,
				"collision_radius": 0.5
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age*variable.particle_lifetime",
					"gradient": {
						"0.07": "#7A4AFF00",
						"0.3499999999999999": "#CF006B26",
						"0.54": "#91D3FF00",
						"0.73": "#D152FF4E",
						"0.92": "#63008E24"
					}
				}
			}
		}
	}
}