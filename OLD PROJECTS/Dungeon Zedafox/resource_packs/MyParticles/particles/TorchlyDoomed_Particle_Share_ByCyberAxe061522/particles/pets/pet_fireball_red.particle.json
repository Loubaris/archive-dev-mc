{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olcdf:dragon_fire_ace",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/flame_atlas_b"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 35,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.25,
				"direction": ["Math.clamp(variable.particle_lifetime-0.1, -2, 0)", 0, "Math.clamp(variable.particle_lifetime-0.25, -4, -12)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.3, 2.5)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": 20,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1-0.5)", 2.5, "(variable.particle_random_1-0.5)"],
				"linear_drag_coefficient": 0.3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.clamp(2*variable.particle_age, 0.5, 1.5)", "Math.clamp(2*variable.particle_age, 0.2, 1.0)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 512,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 10,
						"max_frame": 32,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age*variable.particle_lifetime",
					"gradient": {
						"0.07": "#FFFF0000",
						"0.3499999999999999": "#FFBD4D02",
						"0.54": "#FF450404",
						"0.73": "#FFFF0500",
						"0.92": "#FFFF0000"
					}
				}
			}
		}
	}
}