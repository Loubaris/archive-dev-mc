{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:pet_fireball",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.speed": {
				"type": "linear",
				"input": "variable.particle_age",
				"horizontal_range": "variable.particle_lifetime",
				"nodes": [4.68, -0.12, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 1.8, 0],
				"direction": ["Math.clamp(variable.particle_lifetime-0.1, -2, 0)", 0, "Math.clamp(variable.particle_lifetime-0.25, -4, -12)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.3, 20)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": 20,
			"minecraft:particle_motion_parametric": {
				"relative_position": ["-5+variable.speed", 0, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["Math.clamp((2*variable.particle_age)/50, 0.2, 3)", "Math.clamp((2*variable.particle_age)/50, 0.2, 3)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 8,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age*variable.particle_lifetime",
					"gradient": {
						"0.07": "#FF07FFFF",
						"0.3499999999999999": "#FFFF9A00",
						"0.54": "#FFFFFFFF",
						"0.73": "#FF00EBFF",
						"0.92": "#FFFF9A00"
					}
				}
			}
		}
	}
}