{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olc:nuke_cloud",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 75,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": ["math.sin(variable.emitter_age*260)*8", 0, "math.cos(variable.emitter_age*260)*8"],
				"radius": 5,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1, 6)"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": "Math.random(-100, 100)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(0, 0.25)", "math.random(0, 0.25)", "math.random(0, -0.25)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.01+variable.particle_age)-variable.particle_random_1", "(0.02+variable.particle_age)-variable.particle_random_1"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 0],
						"max_frame": 8,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_lifetime * variable.particle_age",
					"gradient": {
						"0.0": "#ffffffff",
						"2.45": "#FFFCFCFC",
						"5.0": "#ffffffff"
					}
				}
			}
		}
	}
}