{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:footprints",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/footprints"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1,
				"max_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1200
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, -0.5, 0],
				"direction": [0, -0.1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1200
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "minecraft:glass_pane"],
			"minecraft:particle_initial_speed": -2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.1, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.5, 0.5],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": [0, -0.1, 0]
				},
				"uv": {
					"texture_width": 313,
					"texture_height": 313,
					"uv": [0, 0],
					"uv_size": [313, 313]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_lifetime*variable.particle_age)/1200",
					"gradient": {
						"0.0": "#82FFFFFF",
						"1200.0": "#17FEFEFE"
					}
				}
			}
		}
	}
}