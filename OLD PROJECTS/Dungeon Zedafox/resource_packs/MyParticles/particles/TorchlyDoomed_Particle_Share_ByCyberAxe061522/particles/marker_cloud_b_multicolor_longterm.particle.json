{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:marker_cloud_b_multicolor_longterm",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 21,
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.25
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, "1-variable.particle_age", 0],
				"radius": 1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 5
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "minecraft:glass", "minecraft:glass_pane", "minecraft:glass_bottle", "minecraft:stained_glass_pane"],
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_lifetime * variable.particle_age)/75", "(variable.particle_lifetime * -variable.particle_age)/100", "(variable.particle_lifetime * variable.particle_age)/100"],
				"linear_drag_coefficient": "(variable.particle_lifetime * variable.particle_age)*2"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1+(variable.particle_lifetime * variable.particle_age)/10", "0.1+(variable.particle_lifetime * variable.particle_age)/10"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_lifetime * variable.particle_age)",
					"gradient": {
						"0.0": "#FF000000",
						"9.5": "#6EFF0094",
						"25.0": "#FFC900FF",
						"35.0": "#38DAFF00",
						"45.5": "#85B000FF",
						"50.0": "#FF008BFF"
					}
				}
			}
		}
	}
}