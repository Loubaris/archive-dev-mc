{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "olctd:staff_a_orb",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.25,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.5+variable.particle_random_2"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
			"minecraft:particle_initial_speed": "(3+variable.particle_age)*variable.particle_random_2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(1+variable.particle_age) * variable.particle_random_2", "(2+variable.particle_age) * variable.particle_random_2", "(1+variable.particle_age) * variable.particle_random_2"],
				"linear_drag_coefficient": "5-variable.particle_age"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.15*variable.particle_age)", "(0.15*variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [128, 80],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 5,
						"max_frame": 14,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(variable.particle_random_2*variable.particle_lifetime)+variable.particle_random_2",
					"gradient": {
						"0.0": "#FF000000",
						"1.2": "#FF132D76",
						"2.1000000000000005": "#FF0C0C2A",
						"2.9499999999999997": "#FF28262B",
						"3.8": "#FF0B2837",
						"5.0": "#FF070540"
					}
				}
			}
		}
	}
}