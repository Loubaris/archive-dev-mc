{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "fire_1",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/blocks/wool_colored_white"
			}
		},
		"curves": {
			"variable.motion": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 0]
			},
			"variable.coloure": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			},
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.77, 0.63, 0.19]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 10
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "event"
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-0.5, 0.5) * variable.motion", 1, "math.random(-0.5, 0.5) * variable.motion"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5, 2)"
			},
			"minecraft:particle_initial_speed": "math.random(1, 2)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": "math.random(1. 2)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.4*variable.size", "0.4*variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 128,
					"flipbook": {
						"base_UV": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
						"size_UV": [8, 8],
						"step_UV": [0, 16],
						"frames_per_second": 12,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.coloure",
					"gradient": {
						"0.0": "#CCFFD120",
						"0.3": "#CCFF8515",
						"0.64": "#C9FF4848",
						"1.0": "#00000000"
					}
				}
			}
		}
