{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.neowheel": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"broken1": "query.health <= 250"
						}
					]
				},
				"broken1": {
					"on_entry": [
						"/tag @s add is_broken"
					],
					"transitions": [
						{
							"default": "query.health >= 250"
						}
					]
				}
			}
		}
	}
}