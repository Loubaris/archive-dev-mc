{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.magnet": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "clickitem": "query.get_equipped_item_name == 'magnet'"
                        }
                    ]
                },
                "clickitem": {
                    "on_entry": [
                        "/function item/magnet"
                    ],
                    "transitions": [
                        {
                            "default": "query.get_equipped_item_name == 'magnet'"
                        }
                    ]
                }
            }
        }
    }
}