{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.potion2": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"clickitem": "(query.is_using_item) && (query.get_equipped_item_name == 'potion2')"
						}
					]
				},
				"clickitem": {
					"on_entry": [
						"/function item/potion/speed"
					],
					"transitions": [
						{
							"default": "(!query.is_using_item) || (query.get_equipped_item_name != 'potion2')"
						}
					]
				}
			}
		}
	}
}